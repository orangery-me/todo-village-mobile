    "version": "0.2.0",
    "configurations": [
        {
            "name": "e_learning_mobile",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_dev.dart",
            "flutterMode": "debug",
            "args": ["--flavor", "dev", "--dart-define-from-file", "config.json"]
        },
        {
            "name": "e_learning_mobile (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main_staging.dart",
            "args": ["--flavor", "staging", "--dart-define-from-file", "config.json"]
        },
        {
            "name": "e_learning_mobile (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main_prod.dart",
            "args": ["--flavor", "prod", "--dart-define-from-file", "config.json"]
        },  
        {
            "name": "ads_service",
            "cwd": "packages/ads_service",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "ads_service (profile mode)",
            "cwd": "packages/ads_service",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "ads_service (release mode)",
            "cwd": "packages/ads_service",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}